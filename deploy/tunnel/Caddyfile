{
	admin 127.0.0.1:2019
	persist_config off
	default_sni {$PUBLIC_IP}
}

https://{$PUBLIC_IP} {
	# 压缩 JSON 和页面资源，聊天事件流继续直接透传。
	encode zstd gzip {
		match {
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type image/svg+xml*
		}
	}

	tls {
		issuer acme https://acme-v02.api.letsencrypt.org/directory {
			profile shortlived
		}
	}

	@admin path /admin /admin/*
	handle @admin {
		basic_auth bcrypt haike-admin {
			{$ADMIN_AUTH_USER} {$ADMIN_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:15173 {
			header_up Host 127.0.0.1:5173
			header_up -Authorization
			# 覆盖客户端身份，只传递代理认证成功的管理员账号。
			header_up X-Authenticated-User {http.auth.user.id}
		}
	}

	handle {
		# 管理员也需加载管理页面使用的同源共享资源。
		basic_auth bcrypt haike {
			{$BASIC_AUTH_USER} {$BASIC_AUTH_HASH}
			{$ADMIN_AUTH_USER} {$ADMIN_AUTH_HASH}
		}
		reverse_proxy 127.0.0.1:15173 {
			# 本机 Vite 接受回环地址的 Host，SSE 和 WebSocket 由 Caddy 透传。
			header_up Host 127.0.0.1:5173
			header_up -Authorization
			header_up -X-Authenticated-User
		}
	}
}
